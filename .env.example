# Copy to .env.local for local dev. Never commit real values.
# On Vercel, set these in Project Settings -> Environment Variables.

# --- Data source -------------------------------------------------------
# mock = Salesforce-shaped fixtures (default), live = real Salesforce org
DATA_MODE=mock

# --- Salesforce (only needed when DATA_MODE=live) ----------------------
# My Domain URL of the org, e.g. https://yourcompany.my.salesforce.com
SALESFORCE_INSTANCE_URL=
SF_API_VERSION=v62.0
# External Client App credentials (client credentials flow)
SF_CLIENT_ID=
SF_CLIENT_SECRET=

# --- Auth --------------------------------------------------------------
# placeholder = demo users with groups (now), google = Google SSO (production, documented only)
AUTH_MODE=placeholder
# Secret used to sign the session cookie. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Production only (AUTH_MODE=google), documented but not implemented
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
ALLOWED_DOMAIN=
